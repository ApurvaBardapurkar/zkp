# Never commit real secrets.

# MST testnet
MST_RPC_URL=https://testnetrpc.mstblockchain.com
MST_CHAIN_ID=91562037
# Put a funded testnet private key here (0x...)
DEPLOYER_PRIVATE_KEY=

# Pinata (prefer JWT). If your JWT has been shared publicly, revoke it in Pinata now.
