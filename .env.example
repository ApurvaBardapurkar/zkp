# Optional fallback (not recommended vs JWT)
PINATA_API_KEY=
PINATA_API_SECRET=

# Optional: public gateway base for displaying CIDs
IPFS_GATEWAY_BASE=https://gateway.pinata.cloud/ipfs/

# Deployed V2 contracts (MST testnet — also in deployments/scholarship-v2.json)
